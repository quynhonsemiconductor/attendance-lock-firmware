menu "Reader"

config READER_SPI_HOST
    int "SPI host (SPI2_HOST = 1, SPI3_HOST = 2)"
    default 2

config READER_SPI_SCK
    int "SPI SCK GPIO"
    default 12

config READER_SPI_MISO
    int "SPI MISO GPIO"
    default 13

config READER_SPI_MOSI
    int "SPI MOSI GPIO"
    default 11

config READER_CS_OUT
    int "Outside reader CS (IN lane) GPIO"
    default 10

config READER_CS_IN
    int "Inside reader CS (OUT lane) GPIO"
    default 9

config READER_RST_OUT
    int "Outside reader RST GPIO (hard reset + power-down)"
    default 17

config READER_RST_IN
    int "Inside reader RST GPIO"
    default 21

config READER_POLL_MS
    int "Milliseconds between card polls (RC522 powered down between)"
    default 400

config READER_DEBOUNCE_MS
    int "Same card + same reader: ignore re-reads within this window (ms)"
    default 1000

config READER_CROSS_READ_MS
    int "Same card on the other reader: suppress within this window (ms)"
    default 800

config READER_PIR_GPIO
    int "PIR presence sensor GPIO (-1 = no PIR: poll every READER_POLL_MS)"
    default -1
    range -1 48
    help
        Battery work 2026-11-01: an AM312 PIR (push-pull, ~3.3 V high while it
        sees motion, ~2 s retriggerable hold) gates the card polls. Motion
        wakes the chip (GPIO light-sleep wakeup) and starts fast polling;
        without motion the readers are only polled every READER_IDLE_POLL_MS.
        The PIR never decides an unlock — it only decides WHEN to scan.
        Bench wiring (2026-11-03): outside PIR on KSCL -> GPIO18.

config READER_PIR2_GPIO
    int "Second (inside) PIR GPIO (-1 = none)"
    default -1
    range -1 48
    depends on READER_PIR_GPIO >= 0
    help
        Same behaviour as READER_PIR_GPIO; either PIR starts fast polling
        (both readers) and either wakes the chip from deep sleep. Bench
        wiring (2026-11-03): inside PIR on KSDA -> GPIO8. For deep sleep both
        must be RTC GPIOs (ESP32-S3: 0-21).

config READER_PIR_ACTIVE_MS
    int "Fast polling continues this long after the PIR was last high (ms)"
    default 10000
    depends on READER_PIR_GPIO >= 0
    help
        Covers someone who stopped moving while finding the card: the 1 s
        tap-to-read target holds for this long after the last motion.

config READER_IDLE_POLL_MS
    int "Fallback poll period without motion (ms)"
    default 2000
    range 400 9000
    depends on READER_PIR_GPIO >= 0
    help
        A covered or missed PIR still gets a card read within this period
        (bench 2026-11-02: 5 s felt broken when a hand blocked the PIR).
        Must stay under the 10 s task watchdog.

config READER_PIR_DEBUG
    bool "Log every PIR level change seen by the reader task (bench)"
    default n
    depends on READER_PIR_GPIO >= 0
    help
        Logs "pir: GPIOn level 0/1 (isr N)" whenever the sampled level changes,
        to tell a PIR that never drives the pin high (wiring, output level
        under the ESP32-S3 VIH of ~2.5 V) from an interrupt that never fires.

endmenu
