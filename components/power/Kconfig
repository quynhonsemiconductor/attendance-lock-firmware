menu "Power"

config POWER_BATTERY_MONITOR
    bool "Battery voltage monitor"
    default y

config POWER_BATTERY_ADC_CHANNEL
    int "ADC1 channel for the divider tap (GPIO1 = channel 0)"
    default 0

config POWER_BATTERY_DIV_MUL
    int "Divider multiplier (pack mV per ...)"
    default 11

config POWER_BATTERY_DIV_DIV
    int "Divider denominator (pin mV × MUL / DIV = pack mV)"
    default 1

config POWER_BATTERY_LOW_MV
    int "Low-battery threshold (pack mV)"
    default 5000
    help
        Alert at ~5.0 V; the regulator's effective cutoff is ~4.8 V.

endmenu
