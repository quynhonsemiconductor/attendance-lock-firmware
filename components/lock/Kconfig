menu "Lock"

choice LOCK_BACKEND
    prompt "Lock backend"
    default LOCK_BACKEND_SERVO

config LOCK_BACKEND_RELAY
    bool "Relay / strike driver"

config LOCK_BACKEND_SERVO
    bool "Servo bolt (LEDC PWM)"

endchoice

config LOCK_RELAY_GPIO
    int "Relay GPIO"
    default 4

config LOCK_RELAY_ACTIVE
    int "Relay active level (1 = high)"
    default 1
    range 0 1

config LOCK_SERVO_GPIO
    int "Servo signal GPIO"
    default 4

config LOCK_SERVO_FREQ
    int "Servo PWM frequency (Hz)"
    default 50

config LOCK_SERVO_LOCK_US
    int "Servo pulse at the LOCKED position (µs)"
    default 1000

config LOCK_SERVO_UNLOCK_US
    int "Servo pulse at the RELEASED position (µs)"
    default 2000

config LOCK_SERVO_MOVE_MS
    int "Servo travel time (ms the pulse is held)"
    default 700

config LOCK_SERVO_RELEASE
    bool "Release the servo signal after the move (no holding current)"
    default y

config LOCK_SERVO_PWR_GPIO
    int "Servo power switch enable GPIO (-1 = servo always powered)"
    default -1
    range -1 48
    depends on LOCK_BACKEND_SERVO
    help
        Servo power switch board (pcb/servo-power-switch, 2026-11-03): EN on
        GPIO14 drives a P-MOSFET high-side switch on the servo's 6 V. The
        servo is powered only for a move: EN on, LOCK_SERVO_PWR_LEAD_MS for
        the rail to come up, the pulse, then pulse AND power off after
        LOCK_SERVO_MOVE_MS. With LOCK_SERVO_RELEASE=n the power stays on
        (the held pulse needs it). Held off through deep sleep.

config LOCK_SERVO_PWR_ACTIVE
    int "Servo power enable active level (1 = high turns the servo on)"
    default 1
    range 0 1
    depends on LOCK_SERVO_PWR_GPIO >= 0

config LOCK_SERVO_PWR_LEAD_MS
    int "Servo power-up time before the pulse starts (ms)"
    default 20
    range 0 200
    depends on LOCK_SERVO_PWR_GPIO >= 0

endmenu
