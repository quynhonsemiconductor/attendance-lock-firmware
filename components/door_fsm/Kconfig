menu "Door"

config DOOR_UNLOCK_HOLD_MS
    int "Milliseconds the lock stays released after an allowed tap"
    default 5000

config DOOR_FEEDBACK_GPIO_GREEN
    int "Feedback LED green GPIO"
    default 16

config DOOR_FEEDBACK_GPIO_RED
    int "Feedback LED red GPIO"
    default 47

config DOOR_FEEDBACK_GPIO_BUZZER
    int "Feedback buzzer GPIO"
    default 5

config DOOR_EXIT_GPIO
    int "Inside exit button GPIO (-1 = none; active low)"
    default -1
    range -1 21
    help
        KEY1 on the main board (2026-11-03): GPIO6, 10k pull-up to 3.3 V,
        100 nF to GND, the button shorts to GND. A press releases the bolt
        like an allowed tap (same hold window, green + single beep), once
        per press. SECURITY.md states free egress is mechanical (inside
        handle): this button is an ADDITIONAL egress and is off (-1) in the
        default profile until that decision is revisited. It must be an RTC
        GPIO (ESP32-S3: 0-21, enforced by the range): in deep sleep it wakes
        the chip (ext0, level low, which refuses any other pin) and the wake
        itself counts as the press.

config DOOR_EXIT_DEBOUNCE_MS
    int "Exit button debounce (ms)"
    default 50
    range 10 1000
    depends on DOOR_EXIT_GPIO >= 0

config DOOR_EXIT_STUCK_S
    int "Exit button held this long counts as stuck (s)"
    default 60
    range 5 3600
    depends on DOOR_EXIT_GPIO >= 0
    help
        A stuck button stops blocking deep sleep and is not armed as a wake
        source (it would re-wake the chip at once). It is re-armed once it
        reads released again.

endmenu
