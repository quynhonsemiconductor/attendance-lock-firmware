# `prod` profile hardening — ADR §2.8. This profile is what makes
# "stealing the token needs a flash read-out" true.
#
# ⚠ IRREVERSIBLE: several options below BURN eFuses. eFuse writes can never be
# undone — a chip flashed with this profile cannot be un-hardened or re-flashed
# without signed images. Burn only on production terminals, only with the
# prod profile, and keep the signing/encryption keys offline.
#
# Secure Boot v2. Signing is MANUAL and OFFLINE with espsecure (ADR §2.8:
# keys never touch CI), so the build does not sign; the signed image is
# produced before flashing — see docs/PROVISIONING.md.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n

# Flash encryption, RELEASE mode (development keeps a plaintext remnant of
# the image; release does not)
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
# AES-128 on purpose: AES-256 needs TWO key blocks and would collide with
# BLOCK_KEY2 (the NVS HMAC key) — see the block plan in docs/PROVISIONING.md.
CONFIG_SECURE_FLASH_ENCRYPTION_AES128=y

# ROM download mode SECURE (permanent eFuse; DISABLE would brick reflashing).
# JTAG: there is no Kconfig switch — Secure Boot v2 revokes JTAG via
# CONFIG_SECURE_BOOT_ALLOW_JTAG remaining UNSET (asserted in CI), and the
# USB-Serial-JTAG eFuse is burned with espefuse BEFORE the first prod boot
# (docs/PROVISIONING.md; the console is UART0).
CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=y

# NVS encryption with the HMAC-based scheme — the key lives in an eFuse
# (HMAC_KEY); there is deliberately NO nvs_keys partition (partitions.csv).
# Key block plan (eFuses are irreversible — see docs/PROVISIONING.md):
#   BLOCK_KEY0 = flash encryption key (AES-128, generated on-chip)
#   BLOCK_KEY1 = Secure Boot v2 primary signing-key digest
#   BLOCK_KEY2 = NVS HMAC key  -> key_id 2
#   BLOCK_KEY3 = SB backup digest 1, BLOCK_KEY4 = SB backup digest 2
#   (unused SB digest slots are revoked at first boot, so the backups are
#   burned up front; KEY5 spare)
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=2

# Serial console is provisioning-only (§2.8): it can SET the base URL and
# token and print status; the firmware (not the config) enforces that it can
# never read the token back. Enforced in components/provision.
